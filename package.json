{
  "name": "qa-automation-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "start": "node sut/server.mjs",
    "dev": "node scripts/prepare-web.mjs && vite --config vite.config.mjs --host 127.0.0.1",
    "build": "node scripts/prepare-web.mjs && vite build --config vite.config.mjs",
    "preview": "vite preview --config vite.config.mjs --host 127.0.0.1",
    "test": "node --test tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "test:ci": "node scripts/run-node-ci.mjs",
    "test:robot": "node scripts/run-robot.mjs"
  },
  "dependencies": { "@supabase/supabase-js": "2.119.2" },
  "devDependencies": { "vite": "8.3.8" }
}
